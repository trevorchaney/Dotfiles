# ~/.config/gdb/gdbinit -- GDB user init (GDB >= 11 reads this XDG path).
#
# Layout:
#   gdbinit        this file: general settings
#   dashboard.gdb  upstream gdb-dashboard, unmodified (see specs/gdb-config-restructure.md)
#   local.gdb      personal dashboard layout and helper commands

# History ----------------------------------------------------------------------
set history save on
set history filename ~/.gdb_history
set history size unlimited
set history remove-duplicates unlimited

# General ----------------------------------------------------------------------
set pagination off
set confirm off
set python print-stack full
set disassembly-flavor intel
set breakpoint pending on

# Fetch debug symbols for system libraries (Arch: debuginfod.archlinux.org).
# Change to "off" to keep gdb from touching the network.
set debuginfod enabled on

# Printing ---------------------------------------------------------------------
set print pretty on
set print array-indexes on
set print object on
set print static-members on
set print vtbl on

# Auto-load safe paths -----------------------------------------------------------
# libstdc++, glib, etc. printers under /usr/share/gdb/auto-load are trusted by
# default; these add debug-info and Go runtime helper scripts.
add-auto-load-safe-path /usr/lib/debug
add-auto-load-safe-path /usr/lib/go/src/runtime/runtime-gdb.py
add-auto-load-safe-path ~/.local/share/mise/installs/go

# Plugins ----------------------------------------------------------------------
source ~/.config/gdb/dashboard.gdb
source ~/.config/gdb/local.gdb
